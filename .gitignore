# macOS
.DS_Store

# site: dependencies and build output
site/node_modules/
site/dist/
site/dist-next/
site/dist-old/
site/.astro/
site/.wrangler/

# site: generated from book/*.md by site/scripts/convert.mjs
site/src/content/docs/
site/src/sidebar.json
site/src/chapters.json
site/src/lastmod.json
site/src/quiz-index.json

# learning progress is personal and lives in ~/.ai-engineer-cookbook/ (see README);
# ignore the old in-repo location just in case
site/progress.json
site/progress.json.tmp

# local settings and secrets; only the example is committed
.env
.env.*
!.env.example

# Worker secrets for `wrangler dev` (sign-in credentials); only the example is committed
site/.dev.vars
