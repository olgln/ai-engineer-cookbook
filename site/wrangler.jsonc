// Cloudflare Workers deployment: the built site as static assets, plus a Worker script for /api/* and the home page.
// Workers Builds runs `npm run build` and then `npm run deploy` (D1 migrations, then `wrangler deploy`).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-engineer-cookbook",
  // Must not be newer than the workerd release that ships with the pinned wrangler.
  "compatibility_date": "2026-11-04",
  // The account API and the language of the home page; other pages never reach it.
  "main": "./worker/index.mjs",
  "assets": {
    // Astro's build output; dist/_headers carries the security headers.
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only these paths go to the Worker: the API and the home page, which sends a new reader to their
    // language (LANGUAGE_REDIRECT_PATHS); everything else is served from dist/ without running it.
    "run_worker_first": ["/api/*", "/"],
    // The Worker serves the home page from dist/ through this binding when it does not redirect.
    "binding": "ASSETS"
  },
  // Accounts and sessions. Looked up by name: create it once with `npx wrangler d1 create ai-engineer-cookbook`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-engineer-cookbook",
      "migrations_dir": "./migrations"
    }
  ],
  // Daily clean-up of expired sessions (worker/index.mjs `scheduled`), 03:17 UTC.
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  // Served on <name>.<account>.workers.dev; per-version preview URLs stay off so drafts are not public.
  "workers_dev": true,
  "preview_urls": false,
  // No usage telemetry from wrangler, like ASTRO_TELEMETRY_DISABLED for the build.
  "send_metrics": false
}
