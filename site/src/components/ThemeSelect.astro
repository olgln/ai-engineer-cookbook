---
// Starlight's theme switch followed by the account menu. Starlight renders ThemeSelect at the right end of
// the header on wide screens and at the bottom of the mobile menu on narrow ones, so the menu is in both.
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import { stringsFor } from '../locales/strings.mjs';
import { accountMenuHtml } from './account-menu.mjs';

const accountMenu = accountMenuHtml(stringsFor(Astro.locals.starlightRoute.lang));
---

<Default />
<Fragment set:html={accountMenu} />
