---
// The header's right-hand controls in our order: account menu, language switch, theme switch. Starlight
// renders ThemeSelect then LanguageSelect, both at the right end of the header on wide screens and at the
// bottom of the mobile menu on narrow ones; this override renders all three and the LanguageSelect
// override renders nothing, so the order is the same in both places.
import DefaultLanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import DefaultThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { stringsFor } from '../locales/strings.mjs';
import { accountMenuHtml } from './account-menu.mjs';

const accountMenu = accountMenuHtml(stringsFor(Astro.locals.starlightRoute.lang));
---

<Fragment set:html={accountMenu} />
<DefaultLanguageSelect />
<DefaultThemeSelect />
