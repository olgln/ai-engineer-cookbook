---
// Starlight's page frame (header, sidebar, content) followed by a full-width site footer.
import Default from '@astrojs/starlight/components/PageFrame.astro';
import strings from '../locales/ru.json';
import { copyrightLine, footerLinks } from './footer.mjs';

const copyright = copyrightLine(strings, new Date().getFullYear());
const links = footerLinks(strings);
const current = Astro.url.pathname;
---

<Default>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</Default>

<footer class="site-footer print:hidden">
  <p>{copyright}</p>
  {links.map(({ href, label }) => (
    <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>
  ))}
</footer>
