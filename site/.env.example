# Local settings for the study site. All of them are optional.
# Copy this file to .env and change what you need; values set in the shell win over .env.
# The values below are the defaults.

# Address and port of the local server (npm start / npm run dev).
HOST=127.0.0.1
PORT=4321

# Where the learning progress is stored. Keep it outside the repo; ~ is expanded.
PROGRESS_FILE=~/.ai-engineer-cookbook/progress.json

# Upper limit for a progress upload, in bytes.
PROGRESS_MAX_BYTES=2097152
