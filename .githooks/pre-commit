#!/bin/sh
# Runs the site tests before every commit; a failing test blocks the commit.
# Enabled once per clone with: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)/site"
echo "pre-commit: npm test"
npm test --silent >/dev/null 2>&1 || {
  npm test --silent
  echo "pre-commit: tests failed, commit aborted" >&2
  exit 1
}
